# Afuera / Noir OS — production env. Copy to the app dir on the VPS as `.env.production`
# and fill in. NEXT_PUBLIC_* are inlined at BUILD time (set them BEFORE `npm run build`);
# server-side values are read at start by `next start`.

# ── MongoDB (Prisma needs a REPLICA SET) ────────────────────────────────────
# Dedicated single-node replica set for Afuera (deploy/mongo/docker-compose.mongo.yml),
# on 127.0.0.1:27018 so it never clashes with the shared `mongodb` (27017).
DATABASE_URL="mongodb://127.0.0.1:27018/afuera?replicaSet=rs0&directConnection=true"

# ── Supabase (Auth + Storage) ───────────────────────────────────────────────
# BUILD-TIME (inlined). After deploy, add https://afuera.wisdombusara.com to
# Supabase → Authentication → URL Configuration (Site URL + Redirect URLs) so email
# confirmation / sign-in redirects resolve.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# ── AI Workspace (Anthropic) ────────────────────────────────────────────────
# Required only for /ai to respond. Server-side.
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5"

# ── Email check-ins (Resend) ────────────────────────────────────────────────
# Enables the Daily Brief email + the daily timer (deploy/afuera-daily-brief.*).
RESEND_API_KEY="re_..."
NOIR_FROM_EMAIL="Noir OS <onboarding@resend.dev>"
# Guards /api/cron/daily-brief; the systemd timer sends this as the Bearer token.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET="<long-random-string>"
