# Afuera / Noir OS — production env. Copy to the app dir on the VPS as `.env.production`
# and fill in. Build AFTER this file exists: the middleware reads AUTH_SECRET at build.

# ── MongoDB (Prisma needs a REPLICA SET) ────────────────────────────────────
# Dedicated single-node replica set for Afuera (deploy/mongo/docker-compose.mongo.yml),
# on 127.0.0.1:27018 so it never clashes with the shared `mongodb` (27017).
DATABASE_URL="mongodb://127.0.0.1:27018/afuera?replicaSet=rs0&directConnection=true"

# ── Sign-in sessions ────────────────────────────────────────────────────────
# Signs the session cookie. 32+ chars. Changing it signs everyone out (and needs a rebuild).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="<long-random-string>"

# ── Asset Library uploads ───────────────────────────────────────────────────
# Directory on disk; must be writable by the service user (www-data).
ASSETS_DIR="/var/lib/afuera/uploads"

# ── Email (Brevo SMTP relay — same account LoadForge uses) ──────────────────
# Powers the Daily Brief email + the daily timer (deploy/afuera-daily-brief.*).
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="<brevo-smtp-login>"
SMTP_PASS="<brevo-smtp-key>"
MAIL_FROM="Noir OS <info@afuera.wisdombusara.com>"
# Guards /api/cron/daily-brief; the systemd timer sends this as the Bearer token.
CRON_SECRET="<long-random-string>"

# ── AI Workspace (Anthropic) ────────────────────────────────────────────────
# Required only for /ai to respond.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
