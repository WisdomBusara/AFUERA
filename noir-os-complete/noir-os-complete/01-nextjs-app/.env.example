# ── MongoDB (Prisma) ────────────────────────────────────────────────────────
# Prisma's MongoDB connector needs a REPLICA SET — nested writes and emulated
# cascade deletes run in transactions, which a standalone mongod can't do.
# Atlas (easiest): Atlas → Connect → Drivers. It's a replica set out of the box.
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/afuera?retryWrites=true&w=majority"
# Local single-node replica set alternative (run `mongod --replSet rs0` then
# `mongosh --eval 'rs.initiate()'` once):
# DATABASE_URL="mongodb://localhost:27017/afuera?replicaSet=rs0&directConnection=true"

# ── Supabase Auth + Storage (client + server) ───────────────────────────────
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-public-key]"

# ── AI Workspace (Anthropic API) ────────────────────────────────────────────
# console.anthropic.com → API keys. Required for the AI Workspace to respond.
ANTHROPIC_API_KEY="sk-ant-..."
# Optional model override (defaults to claude-sonnet-5).
ANTHROPIC_MODEL="claude-sonnet-5"

# ── Email check-ins (Resend) ────────────────────────────────────────────────
# resend.com → API keys. Enables the Daily Brief email + the daily cron.
RESEND_API_KEY="re_..."
# From address — must be a verified domain, or use onboarding@resend.dev for testing.
NOIR_FROM_EMAIL="Noir OS <onboarding@resend.dev>"
# Protects the /api/cron/daily-brief route; Vercel injects this on cron calls.
CRON_SECRET="a-long-random-string"
