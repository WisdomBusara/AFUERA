# ── MongoDB (Prisma) ────────────────────────────────────────────────────────
# Prisma's MongoDB connector needs a REPLICA SET — nested writes and emulated
# cascade deletes run in transactions, which a standalone mongod can't do.
# Local single-node replica set (run `mongod --replSet rs0`, then `rs.initiate()` once):
DATABASE_URL="mongodb://localhost:27017/afuera?replicaSet=rs0&directConnection=true"
# Atlas alternative (a replica set out of the box):
# DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/afuera?retryWrites=true&w=majority"

# ── Sign-in sessions ────────────────────────────────────────────────────────
# Signs the session cookie. 32+ chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="<long-random-string>"

# ── Asset Library uploads (local disk; defaults to ./uploads) ───────────────
# ASSETS_DIR="./uploads"

# ── Email (any SMTP server; production uses the Brevo relay) ────────────────
# Leave SMTP_HOST empty to keep email off.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Noir OS <info@afuera.wisdombusara.com>"
# Protects the /api/cron/daily-brief route.
CRON_SECRET="a-long-random-string"

# ── AI Workspace (Anthropic API) ────────────────────────────────────────────
# console.anthropic.com → API keys. Required for the AI Workspace to respond.
ANTHROPIC_API_KEY="sk-ant-..."
# Optional model override (defaults to claude-sonnet-5).
ANTHROPIC_MODEL="claude-sonnet-5"
